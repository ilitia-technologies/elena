# Copy this file to .env and supply your own key. Never commit .env.

# FOUNDRY_ENDPOINT=
# FOUNDRY_MODEL_DEPLOYMENT=
# FOUNDRY_API_KEY=

# Optional: send telemetry (server and browser) to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Model query quota: only enforced when NODE_ENV=production (ignored by npm run dev).
#QUOTA_REDIS_URL=redis://*:6379
#QUOTA_IDENTITY_SECRET=